# Local dev: points at the local Postgres instance started by
# `npm run db:local` (scripts/local-postgres.mjs) — no Docker or manual
# Postgres install needed. Matches production (Postgres everywhere), so
# nothing tested locally can silently behave differently on Railway.
#
# For Railway production, set this on the service's Variables tab to
# Railway's Postgres plugin reference, e.g.:  ${{Postgres.DATABASE_URL}}
MERRIER_DATABASE_URL="postgresql://merrier:merrier@localhost:55433/merrier"

# Random secret used to sign customer account session cookies. There is no
# separate admin login — an admin is just a Customer row with isAdmin: true
# (see scripts/make-admin.ts), signed in the same way as everyone else via
# /account/login, so this one secret covers both. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED: leave empty here and generate your own (the app refuses to start in
# production with an empty/short/placeholder value).
CUSTOMER_SESSION_SECRET=""

# Public site URL, used for absolute links (e.g. Paymob billing data).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- PostHog product analytics ---
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="your_posthog_project_token"
NEXT_PUBLIC_POSTHOG_HOST="your_posthog_host"

# --- Better Stack (logs, error tracking, frontend monitoring) ---
# All optional: leave blank and the app runs exactly as before.
# Server logs → Telemetry → Sources → "MERRIER backend":
BETTER_STACK_SOURCE_TOKEN=""
BETTER_STACK_INGESTING_HOST=""
# Server exceptions → Error tracking → Applications → "MERRIER website" → DSN:
BETTER_STACK_ERRORS_DSN=""
# Frontend JS tag (errors, web vitals, analytics, session replay) → same
# application → Frontend tab → the token at the end of the <script> snippet.
# Needed at BUILD time too (the root layout is statically rendered).
BETTER_STACK_JS_TAG_TOKEN=""

# --- Paymob (online card payment) ---
# Leave blank to run with Cash on Delivery only — the checkout will simply
# not offer online payment until these are set. See lib/payment/paymob.ts.
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_IFRAME_ID=""
PAYMOB_HMAC_SECRET=""

# --- Admin order push notifications (Web Push / VAPID) ---
# Lets the admin's phone receive a push the moment a customer order is placed.
# Leave blank to disable the feature (checkout is unaffected). Generate the
# key pair ONCE with:   npm run push:generate-keys
# Keep VAPID_PRIVATE_KEY secret (server environment only, never commit it), and
# don't rotate the pair later — rotating invalidates every registered device.
# VAPID_SUBJECT must be a mailto: address or an https: URL you control.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Number of trusted reverse proxies in front of the app (used to read the real
# client IP from X-Forwarded-For for rate limiting). 1 = Railway's single edge
# proxy; 0 = ignore the header. Never trust more hops than you actually run.
TRUSTED_PROXY_HOPS="1"

# PORT is set automatically by Railway at runtime — do not set it here.
# Locally, omitting it defaults to 3000 (see scripts/start.mjs).

# --- Delivery Location (Checkout map picker + Admin order map) ---
# No environment variables needed. Map tiles are OpenStreetMap, reverse
# geocoding is Nominatim (OpenStreetMap), and the admin "Open in Google Maps"
# link is a plain https://www.google.com/maps?q=lat,lng URL — none of these
# require an API key. See components/DeliveryLocationPicker.tsx.
