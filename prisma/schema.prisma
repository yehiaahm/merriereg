generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL everywhere — local dev included (via a real local Postgres
  // instance started by `npm run db:local`, see scripts/local-postgres.mjs)
  // — deliberately NOT SQLite-in-dev/Postgres-in-prod, so the schema and
  // migrations that get tested locally are exactly what runs on Railway.
  provider = "postgresql"
  // Deliberately NOT named DATABASE_URL: this machine has an unrelated
  // global DATABASE_URL set (pointing at a different project's Postgres
  // database), and env vars from the shell silently take precedence over
  // .env files. A project-specific name makes that collision impossible.
  url      = env("MERRIER_DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
  // Sellable at the POS terminal but excluded from every storefront query —
  // for in-store-only stock that shouldn't show up on the website.
  POS_ONLY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  PAYMOB_CARD
  // In-person sale via the admin POS (/admin/pos) — payment is received
  // immediately, unlike COD/PAYMOB_CARD which settle later.
  POS_CASH
  POS_CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  // Default size chart for every product in this category that has no chart
  // of its own (Product.sizeChartId wins). See SizeChart below.
  sizeChartId String?
  sizeChart   SizeChart? @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  products    Product[]

  @@index([sizeChartId])
}

// Admin-maintained size chart powering the storefront's "Find My Size". There
// is deliberately no built-in/default chart data: a product with no VERIFIED
// chart simply doesn't get a recommendation. Measurements are centimetres
// (weight in kg). See lib/sizing/ for how the chart is interpreted.
model SizeChart {
  id          String     @id @default(cuid())
  name        String
  // BODY: rows are the body measurements a size is meant for.
  // GARMENT: rows are measurements of the garment itself; "ease" says how
  // much bigger than the body it is designed to be.
  basis       String     @default("BODY")
  // GARMENT only: chest/waist/hips were measured flat (half circumference).
  garmentFlat Boolean    @default(false)
  fit         String?
  stretch     String?
  notes       String?
  // Where the numbers come from (tech pack, supplier sheet, own measuring of
  // a sample...). Required before a chart can be marked verified.
  source      String?
  // Only verified charts are used by the storefront. Unverified charts are drafts.
  verified    Boolean    @default(false)
  // JSON: [{ size: "M", measurements: { CHEST: {min,max}, ... } }, ...] smallest → largest.
  sizes       Json
  // JSON: { CHEST: {min,max}, ... } — GARMENT charts only.
  ease        Json       @default("{}")
  products    Product[]
  categories  Category[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String
  status        ProductStatus    @default(ACTIVE)
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id])
  // Overrides the category's size chart for this product.
  sizeChartId   String?
  sizeChart     SizeChart?       @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  images        ProductImage[]
  variants      ProductVariant[]
  wishlistItems WishlistItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([categoryId])
  @@index([sizeChartId])
  @@index([status])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  altText    String?
  position   Int      @default(0)
  colorValue String?
  createdAt  DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String      @unique
  size              String
  color             String
  colorHex          String?
  // Prices stored in piastres (1 EGP = 100 piastres) to avoid float rounding errors.
  price             Int
  compareAtPrice    Int?
  stock             Int         @default(0)
  lowStockThreshold Int         @default(3)
  active            Boolean     @default(true)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([productId, size, color])
  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
}

model Wishlist {
  id        String         @id @default(cuid())
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
}

model Customer {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  phone             String?
  // Grants access to /admin once true. Never settable from signup — only
  // via the `admin:promote` script (see scripts/make-admin.ts), so becoming
  // an admin always requires direct database/server access, not a web request.
  isAdmin           Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orders            Order[]
  // Devices an admin enabled order notifications on (see lib/push/). Only
  // ever created for accounts with isAdmin: true, and ignored at send time
  // if the account has since lost admin access.
  pushSubscriptions PushSubscription[]
}

// One Web Push subscription = one browser/PWA install on one device. An admin
// can have several (phone + laptop). `endpoint` is the push service URL and is
// itself a bearer secret for sending to that device, so it is never returned to
// the client after registration and never logged in full.
model PushSubscription {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  endpoint     String    @unique
  p256dh       String
  auth         String
  // Truncated User-Agent, only used to label devices in the admin UI.
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  // Consecutive failed deliveries; reset on success. A subscription the push
  // service reports as gone (404/410) is deleted immediately instead.
  failureCount Int       @default(0)

  @@index([customerId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  // Set when the order was placed while signed in, or matched to an account
  // afterwards by email/phone (see linkGuestOrders in lib/customer-auth.ts).
  // Guest checkout never requires an account, so this stays nullable.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  customerName  String
  customerPhone String
  customerEmail String?

  shippingGovernorate String
  // Never collected from the customer directly (see requirement to drop the
  // City field from Checkout) — always derived server-side from
  // shippingGovernorate in lib/orders.ts, so this stays required.
  shippingCity        String
  // Nullable: populated from the manual-address fallback fields when the
  // customer types an address, left null when they confirm a map location
  // instead (see deliveryLat/deliveryLng/deliveryAddress below).
  shippingArea        String?
  shippingStreet      String?
  shippingBuilding    String?
  shippingApartment   String?
  shippingNotes       String?

  // Delivery Location picker (Checkout): set only when the customer confirms
  // a map location, never populated automatically. Only saved to the order
  // once the order is actually placed — see components/DeliveryLocationPicker.tsx.
  deliveryLat     Float?
  deliveryLng     Float?
  // Reverse-geocoded human-readable address for the confirmed map location,
  // via Nominatim (OpenStreetMap) — best-effort, may be null even when
  // deliveryLat/deliveryLng are set if reverse geocoding failed.
  deliveryAddress String?

  // All monetary fields in piastres.
  subtotal     Int
  shippingCost Int
  discount     Int     @default(0)
  couponCode   String?
  total        Int

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  // Paymob's own numeric order id, captured when we register the order with
  // them at checkout time. The webhook's HMAC covers `order.id` (this field)
  // but NOT `order.merchant_order_id` — so the webhook handler must match on
  // this, never trust merchant_order_id alone, or a validly-signed webhook
  // from an attacker's own unrelated transaction could be retargeted at any
  // order just by editing that unsigned field. See app/api/webhooks/paymob.
  paymobOrderId Int? @unique

  // Set (atomically, once) when the "new order" push to admins is claimed for
  // this order — makes the notification idempotent across checkout retries,
  // Paymob webhook redelivery and any other duplicate trigger. See
  // lib/push/notify-order.ts.
  adminNotifiedAt DateTime?

  items    OrderItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([customerId])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshot fields captured at purchase time — never recomputed from the
  // live product/variant, since prices and names can change after purchase.
  productName  String
  variantSize  String
  variantColor String
  sku          String
  imageUrl     String?
  unitPrice    Int
  quantity     Int
  subtotal     Int

  @@index([orderId])
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   PaymentMethod
  status     PaymentStatus
  amount     Int
  reference  String?
  rawPayload String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([orderId])
}
